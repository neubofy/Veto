<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0000"
    tools:context=".ui.TheftConfirmedActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VETO: DEVICE LOCKED"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:layout_marginTop="32dp"/>

        <TextView
            android:id="@+id/textViewLockScreenMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This device is locked."
            android:padding="8dp"
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/textViewTheftContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAlignment="center"/>

        <!-- Radar Animation -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp">
            
            <com.neubofy.veto.ui.RadarScanView
                android:id="@+id/radarScanView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
                
            <TextView
                android:id="@+id/radarStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="Scanning nearby devices..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
        </FrameLayout>

        <!-- Terminal Logs -->
        <ScrollView
            android:id="@+id/terminalScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#44000000"
            android:padding="8dp"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:id="@+id/terminalLogText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#00FF00"
                android:typeface="monospace"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"/>
        </ScrollView>

        <Button
            android:id="@+id/buttonUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNLOCK DEVICE"
            android:backgroundTint="#FFFFFF"
            android:textColor="#CC0000"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

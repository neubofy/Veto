<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    tools:context=".ui.TheftSuspectedActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_security"
            app:tint="?attr/colorPrimary"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VETO: DEVICE LOCKED"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="?attr/colorPrimary"/>


        <TextView
            android:id="@+id/textViewLockScreenMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This device is locked."
            android:padding="16dp"
            android:textSize="18sp"
            android:textAlignment="center"/>

        <TextView
            android:id="@+id/textViewTheftContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textAlignment="center"/>

        <!-- Found Phone Instructions -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutFoundPhoneInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#22000000"
            app:cardCornerRadius="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorPrimary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IF YOU FOUND THIS PHONE:"
                    android:textColor="?attr/colorPrimary"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                    
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Put the phone to charging.\n2. Do NOT try to unlock the phone.\n3. Do NOT come near the phone, do NOT move the phone.\n4. Contact the given contact info above, or call 112 and submit it to the police."
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>
                    
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="We will not put allegations on you that you are a thief. We will take responsibility. If you give us our device back, we will praise you and you may get a reward."
                    android:textSize="13sp"
                    android:textStyle="italic"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Static Connection Status Box -->
        <TextView
            android:id="@+id/textViewConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33FF0000"
            android:padding="16dp"
            android:textColor="#FF0000"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_margin="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNLOCK DEVICE"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@color/md_theme_onPrimary"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

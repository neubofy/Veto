<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#120202"
    tools:context=".ui.AutoTheftWarningOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_security"
            app:tint="#ff7b72"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THEFT SUSPECTED"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#ff7b72"/>

        <TextView
            android:id="@+id/textViewWarningMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Device lockdown active due to SIM removal."
            android:textSize="14sp"
            android:textAlignment="center"
            android:textColor="#f0f6fc"/>

        <!-- 3-Min Suspicion Progress & Countdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#21262d"
            android:padding="10dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvGraceCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Theft Confirmation in: 03:00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#58a6ff"
                android:textAlignment="center"/>

            <ProgressBar
                android:id="@+id/progressBarGraceTimer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="180"
                android:progress="0"
                android:progressDrawable="@drawable/custom_progress_drawable" />
        </LinearLayout>

        <!-- Owner Contact Info Card -->
        <LinearLayout
            android:id="@+id/cardOwnerContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#161b22"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 OWNER CONTACT DETAILS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#3fb950"/>

            <TextView
                android:id="@+id/tvContactDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8b949e"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Live Scary Matrix Terminal Log Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💻 SYSTEM LIVE TELEMETRY &amp; BLE MESH STREAM"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#58a6ff"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"/>

        <ScrollView
            android:id="@+id/scrollViewTerminal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvTerminalLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#39ff14"
                android:lineSpacingExtra="2dp"
                android:text="[00:00:00] INITIALIZING SYSTEM DEFENSE MESH..."/>
        </ScrollView>

        <Button
            android:id="@+id/buttonUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNLOCK DEVICE TO VERIFY"
            android:backgroundTint="#da3633"
            android:textColor="#ffffff"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_errorContainer"
    tools:context=".ui.AutoTheftWarningOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_security"
            app:tint="@color/md_theme_onErrorContainer"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THEFT SUSPECTED"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/md_theme_onErrorContainer"/>

        <TextView
            android:id="@+id/textViewWarningMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Device lockdown imminent due to unauthorized activity."
            android:padding="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/md_theme_onErrorContainer"/>
            
        <TextView
            android:id="@+id/textViewInstructions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:text="To prove you are the legitimate owner, please do one of the following:\n\n• Unlock this device\n• Plug into a charger\n• Reinsert the owner SIM"
            android:padding="16dp"
            android:textSize="18sp"
            android:textAlignment="center"
            android:textColor="@color/md_theme_onErrorContainer"/>

        <Button
            android:id="@+id/buttonUnlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UNLOCK DEVICE TO VERIFY"
            android:backgroundTint="@color/md_theme_error"
            android:textColor="@color/md_theme_onError"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
